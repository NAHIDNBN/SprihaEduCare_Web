@{
    ViewData["Title"] = "Spriha Education Care";
}

<style>
    .carousel,
    .carousel-inner,
    .carousel-item,
    .carousel-item img {
        height: 100%;
        object-fit: initial;
    }

    .carousel-item {
    }

        .carousel-item img {
        }

    .active {
    }

    .carousel-indicators {
        position: absolute;
        align-items: center;
    }

        .carousel-indicators [data-bs-target] {
            background-color: white;
            padding: 6px;
            border-radius: 50%;
            height: 0;
            width: 0;
        }

        .carousel-indicators .active {
            padding: 7px !important;
        }

    .carousel-control-next-icon,
    .carousel-control-prev-icon {
        width: 3rem;
        height: 3rem;
    }

    .carousel-control-next,
    .carousel-control-prev {
        width: 5%;
    }

    .hero-3 {
        display: flex;
    }

    .aboutSpriha {
        width: 50%;
        background: linear-gradient(to bottom, rgba(0, 24, 68, 0.2), rgba(188, 188, 188, 0.3));
        padding: 30px;
        text-align: center;
        color: #001844;
        font-size: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
    }

        .aboutSpriha h2 {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 30px;
            color: #001844;
        }

        .aboutSpriha h3 {
            color: #001844;
            margin-top: 10px;
            font-size: 1.4rem;
            font-weight: 600;
        }

        .aboutSpriha p {
            font-size: 1.05rem;
            line-height: 1.8;
            margin-bottom: 15px;
            color: rgba(0, 0, 0, 0.6);
        }

    .video-container {
        width: 70%;
        box-shadow: inset 0 0 150px 0px #001844 !important;
    }

        .video-container iframe {
            width: 100%;
            height: 100%;
        }

    .ytp-cued-thumbnail-overlay-image,
    .ytp-cued-thumbnail-overlay {
        box-shadow: inset 0 0 150px 0px #001844 !important;
    }

    .programs {
        padding: 5rem 2rem;
        box-shadow: inset 0 0 100px 0px #bcbcbc;
    }

    .programImg {
        height: 100%;
        width: 100%;
        padding: 10px;
        transition: transform 0.5s;
    }

        .programImg:hover {
            transform: scale(1.05);
        }

    .programsTitle {
        background: linear-gradient(-30deg, #2f74ba 50%, #001844);
        padding: 10px 100px;
        text-align: center;
        color: #f1f1f1;
        font-size: 35px;
        font-weight: 600;
        width: auto;
        border-radius: 50px;
        border: 3px solid #f1f1f1;
    }

    .teachersMain {
        width: 50%;
        padding: 35px;
        background-color: #f1f1f1;
    }

    .teacherTitleMain {
        background: linear-gradient(-30deg, #2f74ba 52%, #001844 50%);
        padding: 10px 20px;
        text-align: center;
        color: #f1f1f1;
        font-size: 20px;
        font-weight: 600;
        width: auto;
        border-radius: 0;
        border: 3px solid #f1f1f1;
    }

    .slider {
        width: 600px;
        height: 400px;
        overflow: hidden;
        position: relative;
        margin: auto;
    }

    .slides {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.5s ease-in-out;
    }

        .slides img {
            width: 600px;
            height: 400px;
        }

    .navigation {
        position: absolute;
        width: 100%;
        top: 50%;
        display: flex;
        justify-content: space-between;
        transform: translateY(-50%);
    }

    .nav-btn {
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
    }

    .teachersList {
        border: 2px solid white;
        padding: 10px 50px;
        text-align: center;
        color: #2f74ba;
        font-size: 17px;
        font-weight: 600;
        width: auto;
        border-radius: 0;
    }

    .resPrograms {
        padding: 5rem;
        box-shadow: inset 0 0 50px 0px #bcbcbc;
    }

    .ourTeacher {
        padding: 10px;
    }

    .title-partner {
        font-size: 50px;
        font-weight: 600;
        color: #009cdc;
        padding: 20px;
    }

    .gallery-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .gallery {
        width: 1320px;
        display: flex;
        overflow-x: scroll;
    }

        .gallery div {
            flex: none;
        }

            .gallery div img {
                width: 175px;
                height: 220px;
                border-radius: 0;
                transition: transform 0.5s;
            }

        .gallery::-webkit-scrollbar {
            display: none;
        }

    #backBtn,
    #nextBtn {
        cursor: pointer;
        margin: 35px;
    }

    .gallery div img:hover {
        filter: grayscale(0);
        cursor: pointer;
        transform: scale(1.1);
    }

    .logos {
        overflow: hidden;
        white-space: nowrap;
        position: relative;
    }

        .logos:before,
        .logos:after {
            position: absolute;
            top: 0;
            height: 100%;
            content: "";
            z-index: 2;
        }

        .logos:before {
            left: 0;
        }

        .logos:after {
            right: 0;
        }

        .logos:hover .logos-slide {
            animation-play-state: paused;
        }

    .logos-slide {
        display: inline-block;
        animation: 60s slide infinite linear;
    }

    .ourTeacherImage {
        margin-right: 15px;
    }

    @@keyframes slide {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-100%);
        }
    }

    @@media (max-width: 768px) {
    }
</style>

